generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Chain {
  STARKNET
  ETHEREUM
  SOLANA
  BASE
  STELLAR
  BITCOIN
}

enum TokenStandard {
  ERC721
  ERC1155
  ERC20
}

enum ReportTargetType {
  COLLECTION
  TOKEN
  CREATOR
  COMMENT
}

enum ReportCategory {
  COPYRIGHT_PIRACY
  VIOLENCE_GRAPHIC
  HATE_SPEECH
  SCAM_FRAUD
  SPAM
  NSFW
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  HIDDEN
  DISMISSED
  RESTORED
}

enum ClaimStatus {
  PENDING
  AUTO_APPROVED
  APPROVED
  REJECTED
}

enum UsernameClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationMethod {
  ONCHAIN
  SIGNATURE
  MANUAL
}

model IndexerCursor {
  chain             Chain    @id
  lastBlock         BigInt
  updatedAt         DateTime @updatedAt
}

model SourceCursor {
  chain     Chain
  sourceId  String
  lastBlock BigInt
  updatedAt DateTime @updatedAt

  @@id([chain, sourceId])
}

enum OrderStatus {
  ACTIVE
  FULFILLED
  CANCELLED
  EXPIRED
}

model Order {
  id                       String      @id @default(cuid())
  chain                    Chain       @default(STARKNET)
  orderHash                String
  offerer                  String
  offerItemType            String
  offerToken               String
  offerIdentifier          String
  offerStartAmount         String
  offerEndAmount           String
  considerationItemType    String
  considerationToken       String
  considerationIdentifier  String
  considerationStartAmount String
  considerationEndAmount   String
  considerationRecipient   String
  startTime                BigInt
  endTime                  BigInt
  status                   OrderStatus @default(ACTIVE)
  fulfiller                String?
  createdBlockNumber       BigInt
  createdTxHash            String
  fulfilledTxHash          String?
  cancelledTxHash          String?
  nftContract              String?
  nftTokenId               String?
  priceRaw                 String?
  priceFormatted           String?
  currencySymbol           String?
  parentOrderHash          String?
  counterOfferMessage      String?
  marketplaceContract      String?
  marketplaceService       String?
  remainingAmount          String?
  fills                    OrderFill[]
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@unique([chain, orderHash])
  @@index([chain, offerer])
  @@index([chain, nftContract, nftTokenId])
  @@index([chain, parentOrderHash])
  @@index([chain, status, nftContract])
  @@index([considerationToken])
  @@index([createdAt])
  @@index([chain, updatedAt])
  @@index([marketplaceContract])
  @@index([marketplaceService])
  @@index([chain, fulfiller])
}

model OrderFill {
  id              String   @id @default(cuid())
  chain           Chain    @default(STARKNET)
  orderHash       String
  order           Order    @relation(fields: [chain, orderHash], references: [chain, orderHash])
  fulfiller       String
  quantity        String   @default("1")
  remainingAmount String?
  priceRaw        String?
  priceFormatted  String?
  currencySymbol  String?
  currencyToken   String?
  nftContract     String?
  nftTokenId      String?
  txHash          String
  logIndex        Int
  blockNumber     BigInt
  createdAt       DateTime @default(now())

  @@unique([chain, orderHash, txHash, logIndex])
  @@index([chain, nftContract, nftTokenId])
  @@index([createdAt])
}

enum MetadataStatus {
  PENDING
  FETCHING
  FETCHED
  FAILED
}

model Token {
  id              String         @id @default(cuid())
  chain           Chain          @default(STARKNET)
  contractAddress String
  tokenId         String
  tokenUri        String?
  metadataStatus  MetadataStatus @default(PENDING)
  isHidden        Boolean        @default(false)
  name            String?
  description     String?        @ignore
  image           String?
  animationUrl    String?
  attributes      Json?
  ipType          String?
  licenseType     String?
  commercialUse   Boolean?
  author          String?
  transfers       Transfer[]
  collection      Collection?    @relation(fields: [chain, contractAddress], references: [chain, contractAddress])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([chain, contractAddress, tokenId])
  @@index([chain, metadataStatus])
  @@index([chain, ipType])
  @@index([chain, isHidden, metadataStatus, createdAt])
}

model Collection {
  id              String             @id @default(cuid())
  chain           Chain              @default(STARKNET)
  contractAddress String
  collectionId    String?
  name            String?
  symbol          String?
  description     String?
  image           String?
  attributes      Json?
  baseUri         String?
  owner           String?
  metadataStatus  MetadataStatus     @default(PENDING)
  startBlock      BigInt
  isFeatured      Boolean            @default(false)
  isHidden        Boolean            @default(false)
  tokens          Token[]
  standard        TokenStandard
  service         String
  claimedBy       String?
  profile         CollectionProfile?
  drop            Drop?
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([chain, contractAddress])
  @@index([owner])
  @@index([chain, isHidden])
  @@index([chain, service])
}

model Coin {
  id              String        @id @default(cuid())
  chain           Chain         @default(STARKNET)
  contractAddress String
  standard        TokenStandard @default(ERC20)
  service         String
  name            String?
  symbol          String?
  decimals        Int           @default(18)
  totalSupply     String?
  description     String?
  image           String?
  creator         String?
  isLaunched      Boolean?
  startBlock      BigInt
  isHidden        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([chain, contractAddress])
  @@index([chain, service])
  @@index([chain, isHidden])
}

model CollectionProfile {
  id                String     @id @default(cuid())
  collection        Collection @relation(fields: [chain, contractAddress], references: [chain, contractAddress])
  contractAddress   String
  chain             Chain
  displayName       String?
  description       String?
  image             String?
  bannerImage       String?
  websiteUrl        String?
  twitterUrl        String?
  discordUrl        String?
  telegramUrl       String?
  gatedContentTitle String?
  gatedContentUrl   String?
  gatedContentType  String?
  hasGatedContent   Boolean    @default(false)
  slug              String?    @unique
  updatedBy         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([chain, contractAddress])
}

model UsernameClaim {
  id            String              @id @default(cuid())
  username      String
  walletAddress String
  status        UsernameClaimStatus @default(PENDING)
  adminNotes    String?
  notifyEmail   String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([walletAddress])
  @@index([status])
  @@index([username])
}

model CollectionSlugClaim {
  id              String              @id @default(cuid())
  slug            String
  contractAddress String
  chain           Chain               @default(STARKNET)
  walletAddress   String
  status          UsernameClaimStatus @default(PENDING)
  adminNotes      String?
  notifyEmail     String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([walletAddress])
  @@index([contractAddress])
  @@index([status])
  @@index([slug])
}

model CollectionClaim {
  id                 String             @id @default(cuid())
  contractAddress    String
  chain              Chain              @default(STARKNET)
  claimantAddress    String?
  claimantEmail      String?
  status             ClaimStatus        @default(PENDING)
  verificationMethod VerificationMethod
  notes              String?
  adminNotes         String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([chain, contractAddress])
  @@index([status])
  @@index([chain, claimantAddress])
}

model ClaimChallenge {
  id              String   @id @default(cuid())
  chain           Chain    @default(STARKNET)
  contractAddress String
  walletAddress   String
  challenge       String   @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([walletAddress, contractAddress])
}

enum WalletActivityType {
  SEND
  RECEIVE
  SWAP
  DEPLOY
  GUARDIAN_SET
  GUARDIAN_TRIGGER_ESCAPE
  GUARDIAN_COMPLETE_ESCAPE
  GUARDIAN_CANCEL_ESCAPE
}

model WalletActivity {
  id              String             @id @default(cuid())
  chain           Chain              @default(STARKNET)
  accountAddress  String
  type            WalletActivityType
  txHash          String
  blockNumber     BigInt
  timestamp       DateTime
  tokenAddress    String?
  amount          String?
  counterparty    String?
  tokenInAddress  String?
  amountIn        String?
  tokenOutAddress String?
  amountOut       String?
  createdAt       DateTime           @default(now())

  @@unique([chain, txHash, type, accountAddress])
  @@index([chain, accountAddress, timestamp])
}

model WalletActivityCursor {
  chain           Chain    @default(STARKNET)
  accountAddress  String
  lastSyncedBlock BigInt
  updatedAt       DateTime @updatedAt

  @@id([chain, accountAddress])
}

model BlockTimestamp {
  chain       Chain
  blockNumber BigInt
  timestamp   DateTime
  createdAt   DateTime @default(now())

  @@id([chain, blockNumber])
}

model SiwsNonce {
  id            String   @id @default(cuid())
  chain         Chain    @default(STARKNET)
  walletAddress String
  nonce         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([walletAddress])
}

model Transfer {
  id              String   @id @default(cuid())
  chain           Chain    @default(STARKNET)
  contractAddress String
  tokenId         String
  fromAddress     String
  toAddress       String
  amount          String   @default("1")
  blockNumber     BigInt
  txHash          String
  logIndex        Int
  token           Token    @relation(fields: [chain, contractAddress, tokenId], references: [chain, contractAddress, tokenId])
  createdAt       DateTime @default(now())

  @@unique([chain, txHash, logIndex])
  @@index([chain, contractAddress, tokenId])
  @@index([chain, toAddress])
  @@index([chain, fromAddress])
  @@index([chain, blockNumber])
  @@index([chain, createdAt])
}

model TokenBalance {
  id              String   @id @default(cuid())
  chain           Chain    @default(STARKNET)
  contractAddress String
  tokenId         String
  owner           String
  amount          String
  updatedAt       DateTime @updatedAt

  @@unique([chain, contractAddress, tokenId, owner])
  @@index([chain, owner])
}

model SponsorshipOffer {
  id              String           @id @default(cuid())
  chain           Chain            @default(STARKNET)
  contractAddress String
  offerId         String
  author          String
  nftContract     String
  tokenId         String
  minAmount       String
  duration        Int
  paymentToken    String
  licenseTermsUri String
  transferable    Boolean
  royaltyBps      Int
  specificSponsor String?
  open            Boolean          @default(true)
  bids            SponsorshipBid[]
  createdAtChain  DateTime
  updatedAt       DateTime         @updatedAt

  @@unique([chain, contractAddress, offerId])
  @@index([chain, contractAddress, open])
  @@index([chain, author])
  @@index([chain, nftContract, tokenId])
}

model SponsorshipBid {
  id              String           @id @default(cuid())
  chain           Chain            @default(STARKNET)
  contractAddress String
  offerId         String
  sponsor         String
  amount          String
  placedAtChain   DateTime
  offer           SponsorshipOffer @relation(fields: [chain, contractAddress, offerId], references: [chain, contractAddress, offerId])
  updatedAt       DateTime         @updatedAt

  @@unique([chain, contractAddress, offerId, sponsor])
  @@index([chain, sponsor])
}

model SponsorshipProposal {
  id              String    @id @default(cuid())
  chain           Chain     @default(STARKNET)
  contractAddress String
  proposalId      String
  proposer        String
  nftContract     String
  tokenId         String
  amount          String
  duration        Int
  validUntil      DateTime?
  paymentToken    String
  licenseTermsUri String
  transferable    Boolean
  royaltyBps      Int
  open            Boolean   @default(true)
  accepted        Boolean?
  createdAtChain  DateTime
  closedAtChain   DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([chain, contractAddress, proposalId])
  @@index([chain, contractAddress, open])
  @@index([chain, proposer])
  @@index([chain, nftContract, tokenId])
}

model SponsorshipLicense {
  id              String   @id @default(cuid())
  chain           Chain    @default(STARKNET)
  contractAddress String
  tokenId         String
  author          String
  recipient       String
  assetContract   String
  assetTokenId    String
  expiresAt       DateTime
  transferable    Boolean
  royaltyBps      Int
  licenseTermsUri String
  offerId         String?
  proposalId      String?
  mintedAtChain   DateTime

  @@unique([chain, contractAddress, tokenId])
  @@index([chain, author])
  @@index([chain, assetContract, assetTokenId])
}

enum IntentType {
  CREATE_LISTING
  MAKE_OFFER
  FULFILL_ORDER
  CANCEL_ORDER
  MINT
  CREATE_COLLECTION
  COUNTER_OFFER
  CREATE_TIER
  CREATE_SPONSORSHIP_OFFER
  SET_SPONSORSHIP_OFFER_OPEN
  PLACE_SPONSORSHIP_BID
  RETRACT_SPONSORSHIP_BID
  ACCEPT_SPONSORSHIP_BID
  CREATE_SPONSORSHIP_PROPOSAL
  WITHDRAW_SPONSORSHIP_PROPOSAL
  ACCEPT_SPONSORSHIP_PROPOSAL
  REJECT_SPONSORSHIP_PROPOSAL
  CREATE_COIN
  LAUNCH_COIN
  TRANSFER_TOKEN
  TRANSFER_NFT
  TRANSFER_COLLECTION_OWNERSHIP
  ADD_COMMENT
  GENESIS_MINT
  POP_CLAIM
  POP_BURN
  DROP_CLAIM
  WALLET_MANAGE
  SWAP
  FUNDING_TRANSFER
  DROP_MANAGE
  POP_MANAGE
}

enum IntentStatus {
  PENDING
  SIGNED
  SUBMITTED
  CONFIRMED
  FAILED
  EXPIRED
}

model TransactionIntent {
  id                  String       @id @default(cuid())
  chain               Chain        @default(STARKNET)
  type                IntentType
  status              IntentStatus @default(PENDING)
  requester           String
  accountId           String?
  typedData           Json
  calls               Json
  signature           String[]
  txHash              String?
  orderHash           String?
  parentOrderHash     String?
  counterOfferMessage String?
  expiresAt           DateTime
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([chain, requester])
  @@index([chain, status])
  @@index([expiresAt, status])
}

model ApiKey {
  id          String       @id @default(cuid())
  apiCreditsId String
  apiCredits   ApiCredits    @relation(fields: [apiCreditsId], references: [id], onDelete: Cascade)
  prefix      String
  keyHash     String       @unique
  label       String       @default("")
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([apiCreditsId])
}

model Report {
  id             String           @id @default(cuid())
  chain          Chain            @default(STARKNET)
  targetType     ReportTargetType
  targetKey      String
  targetContract String?
  targetTokenId  String?
  targetAddress  String?
  reporterWallet String           @default("")
  reviewedBy     String?
  categories     ReportCategory[]
  description    String?
  status         ReportStatus     @default(PENDING)
  adminNotes     String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([targetKey, reporterWallet])
  @@index([status])
  @@index([targetType, targetKey])
  @@index([createdAt])
}


model HiddenCreator {
  chain    Chain    @default(STARKNET)
  address  String
  hiddenAt DateTime @default(now())

  @@id([chain, address])
}


enum AccountStatus {
  ACTIVE
  PENDING
  INACTIVE
}

model Account {
  id        String        @id @default(cuid())
  publicId  String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  status AccountStatus @default(ACTIVE)

  identities Identity[]
  profile    AccountProfile?
  notices    AccountNotice[]

  apiCredits ApiCredits?
  events     AccountEvent[]

  @@index([createdAt])
}

model AccountEvent {
  id        String           @id @default(cuid())
  accountId String
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type      AccountEventType
  data      Json
  createdAt DateTime         @default(now())

  @@index([accountId, createdAt])
}

enum AccountEventType {
  EMAIL_CHANGED
  WALLET_REPLACED
  WALLET_KEY_ADDED
  API_KEY_CREATED
  API_KEY_DELETED
  STATUS_CHANGED
}

model AccountNotice {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  kind      String
  createdAt DateTime @default(now())

  @@unique([accountId, kind])
  @@index([kind, createdAt])
}

model ApiCredits {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  creditBalance Int  @default(0)

  apiKey               ApiKey?
  payments             Payment[]
  fundingIntents       FundingIntent[]
  usage                UsageEvent[]
  entries              CreditEntry[]
  launchpadRuns        LaunchpadRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}

model Identity {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  scheme   String
  provider String?

  chain   Chain?
  address String?

  value String?

  appId      String
  app        App        @relation(fields: [appId], references: [id])
  createdAt  DateTime  @default(now())

  @@unique([accountId, scheme])
  @@unique([appId, chain, address])
  @@index([appId, scheme, value])
  @@index([address])
}

model App {
  id           String     @id
  name         String
  secretHashes String[]   @default([])
  createdAt    DateTime   @default(now())
  identities   Identity[]
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model AccountProfile {
  id          String   @id @default(cuid())
  accountId   String   @unique
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String?
  bio         String?
  avatarImage String?
  websiteUrl  String?
  twitterUrl  String?
  discordUrl  String?
  telegramUrl String?
  username    String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id              String   @id @default(cuid())
  chain           Chain    @default(STARKNET)
  contractAddress String
  tokenId         String
  author          String
  content         String
  isHidden        Boolean  @default(false)
  txHash          String?
  blockNumber     BigInt
  blockTimestamp  BigInt
  logIndex        Int
  createdAt       DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([chain, contractAddress, tokenId])
  @@index([author])
}

enum RemixOfferStatus {
  PENDING
  AUTO_PENDING
  APPROVED
  COMPLETED
  REJECTED
  EXPIRED
  SELF_MINTED
}

model UserScore {
  address      String   @id
  accountId    String?
  chain        Chain    @default(STARKNET)
  totalXp      Int      @default(0)
  currentLevel Int      @default(1)
  breakdown    Json     @default("{}")
  computedAt   DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([totalXp])
  @@index([currentLevel])
  @@index([chain])
  @@index([accountId])
}

model UserBadge {
  id        String          @id @default(cuid())
  address   String
  accountId String?
  badgeKey  String
  awardedAt DateTime        @default(now())
  txHash    String?

  @@unique([address, badgeKey])
  @@index([accountId])
}

model PointEvent {
  id         String   @id @default(cuid())
  chain      Chain    @default(STARKNET)
  address    String
  accountId  String?
  actionType String
  xp         Int
  multiplier Float    @default(1.0)
  finalXp    Int
  txHash     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([address])
  @@index([accountId])
  @@index([actionType])
  @@index([createdAt])
  @@index([chain, address])
}

model RemixOffer {
  id     String           @id @default(cuid())
  status RemixOfferStatus @default(PENDING)

  originalContract String
  originalTokenId  String
  creatorAddress   String

  requesterAddress String?
  message          String?

  proposedPrice    String
  proposedCurrency String

  licenseType String
  commercial  Boolean @default(false)
  derivatives Boolean @default(true)
  royaltyPct  Int?

  approvedCollection String?
  remixContract      String?
  remixTokenId       String?
  orderHash          String?

  createdAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([orderHash])
  @@index([originalContract, originalTokenId])
  @@index([creatorAddress])
  @@index([requesterAddress])
  @@index([status, expiresAt])
}

model ServiceContract {
  id              String   @id @default(cuid())
  serviceId       String
  chain           Chain
  contractAddress String
  startBlock      String
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())

  @@index([serviceId])
  @@index([chain, active])
}

model Payment {
  id             String        @id @default(cuid())
  apiCreditsId    String?
  apiCredits      ApiCredits?    @relation(fields: [apiCreditsId], references: [id], onDelete: Cascade)
  payer          String?
  scheme         String
  network        String
  asset          String
  amountAtomic   String
  creditedAmount Int
  mdlnMultiplier Float         @default(1.0)
  status         PaymentStatus @default(SETTLED)
  txHash         String
  proofNonce     String        @unique
  createdAt      DateTime      @default(now())

  fundingIntentId String?        @unique
  fundingIntent   FundingIntent? @relation(fields: [fundingIntentId], references: [id], onDelete: SetNull)

  @@index([apiCreditsId])
  @@index([payer])
}

model UsageEvent {
  id          String    @id @default(cuid())
  apiCreditsId String
  apiCredits   ApiCredits @relation(fields: [apiCreditsId], references: [id], onDelete: Cascade)

  actionKey   String
  chain       String
  service     String
  unitCredits Int
  units       Int
  credits     Int

  method String
  path   String
  status Int

  createdAt DateTime @default(now())

  @@index([apiCreditsId, createdAt])
  @@index([actionKey])
}

enum PaymentStatus {
  SETTLED
  FAILED
  UNATTRIBUTED
}

enum FundingIntentStatus {
  PENDING
  SETTLED
  FAILED
  EXPIRED
}

model FundingIntent {
  id          String              @id @default(cuid())
  apiCreditsId String
  apiCredits   ApiCredits           @relation(fields: [apiCreditsId], references: [id], onDelete: Cascade)
  method      String
  status      FundingIntentStatus @default(PENDING)
  payer       String?
  params      Json
  expiresAt   DateTime
  settledAt   DateTime?
  createdAt   DateTime            @default(now())
  payment     Payment?

  @@index([apiCreditsId, status])
  @@index([payer, status])
  @@index([status, expiresAt])
}

enum LaunchpadRunStatus {
  DRAFT
  PAID
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model LaunchpadRun {
  id           String             @id @default(cuid())
  apiCreditsId  String
  apiCredits    ApiCredits          @relation(fields: [apiCreditsId], references: [id], onDelete: Cascade)
  service      String
  status       LaunchpadRunStatus @default(DRAFT)
  spec         Json
  quote        Json?
  creditsHeld  Int                @default(0)
  creditsSpent Int                @default(0)
  paymentId    String?            @unique
  progress     Json               @default("{}")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([apiCreditsId, status])
}

enum CreditEntryKind {
  OPENING
  PAYMENT
  GRANT
  USAGE
  REFUND
}

model CreditEntry {
  id             String          @id @default(cuid())
  apiCreditsId   String
  apiCredits     ApiCredits      @relation(fields: [apiCreditsId], references: [id], onDelete: Cascade)
  kind           CreditEntryKind
  credits        Int
  paymentId      String?
  usageEventId   String?
  launchpadRunId String?
  note           String?
  createdAt      DateTime        @default(now())

  @@index([apiCreditsId, createdAt])
  @@index([paymentId])
}

model Drop {
  chain              Chain      @default(STARKNET)
  collectionAddress  String
  dropId             String
  organizer          String
  maxSupply          Decimal    @db.Decimal(78, 0)
  startTime          Decimal    @db.Decimal(20, 0)
  endTime            Decimal    @db.Decimal(20, 0)
  price              Decimal    @db.Decimal(78, 0)
  paymentToken       String
  maxPerWallet       Decimal    @db.Decimal(78, 0)
  allowlistRoot      String
  allowlistRootBlock BigInt
  minted             Decimal    @default(0) @db.Decimal(78, 0)
  revenue            Decimal    @default(0) @db.Decimal(78, 0)
  collectors         Int        @default(0)
  createdBlock       BigInt
  collection         Collection @relation(fields: [chain, collectionAddress], references: [chain, contractAddress])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@id([chain, collectionAddress])
  @@index([chain, organizer])
  @@index([chain, startTime])
}

enum DropMintKind {
  CLAIM
  ISSUE
}

model DropMint {
  id                String       @id @default(cuid())
  chain             Chain        @default(STARKNET)
  collectionAddress String
  kind              DropMintKind
  wallet            String
  quantity          Decimal      @db.Decimal(78, 0)
  firstTokenId      Decimal      @db.Decimal(78, 0)
  totalPaid         Decimal      @default(0) @db.Decimal(78, 0)
  blockNumber       BigInt
  txHash            String
  logIndex          Int
  createdAt         DateTime     @default(now())

  @@unique([chain, collectionAddress, txHash, logIndex])
  @@index([chain, collectionAddress, blockNumber])
}
